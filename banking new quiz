
on:
  schedule:
    - cron: "30 2 * * *"
  workflow_dispatch:

jobs:
  quiz:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Install requests
        run: pip install requests

      - name: Run Quiz Bot
        env:
          BOT_TOKEN: ${{ secrets.BOT_TOKEN }}
          RRB_SSC_CHAT_ID: ${{ secrets.RRB_SSC_CHAT_ID }}
          BANKING_CHAT_ID: ${{ secrets.BANKING_CHAT_ID }}
        run: python bot.py
